{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "obsy-launcher",
  "version": "0.1.0",
  "identifier": "com.m1handr.obsy-launcher",
  "build": {
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Obsy Launcher",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
