{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "obsy-launcher",
  "version": "0.1.0",
  "identifier": "com.m1handr.obsy-launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Obsy Launcher",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MDFFNkFGOEVCRUM0OEYKUldTUHhMNk9yK1lCeGo3aFlFaXBIakl0a3ozUGZ6MGhZMk9ZWTFOYzJzdUduVklHZzNseHM4Q0UK",
      "endpoints": [
        "https://github.com/m1handr/obsy-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
