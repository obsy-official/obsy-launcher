{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsy Launcher",
  "version": "0.1.9",
  "identifier": "com.obsy-official.obsy-launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Obsy Launcher",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mc-heads.net https://minotar.net https://textures.minecraft.net; font-src 'self' data:; connect-src 'self' https: ipc: http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyOTk2NjY4NzY1QzM3NjkKUldScE4xeDJhR2FaZ3B1SUo4Z2x5OHY4NmVyc0tHN3I2cHRzd0M1STkxY2RyVmxSUEpHYStzUmMK",
      "endpoints": [
        "https://github.com/obsy-official/obsy-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
