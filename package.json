{
  "name": "obsy-launcher",
  "private": true,
  "description": "Obsy Launcher - A modern cross-platform Minecraft launcher",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:addons": "bun scripts/build-addons.ts",
    "capture:screenshots": "bun scripts/capture-screenshots.ts",
    "check": "bun check",
    "build": "bun check && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "prepare": "lefthook install",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "i18next": "^26.7.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "skinview3d": "^3.4.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
